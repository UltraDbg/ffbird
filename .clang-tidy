---
Checks: 'clang-*,modernize-*,readability-*,performance-*,bugprone-*,-modernize-use-trailing-return-type'
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: llvm-header-guard.HeaderFileExtensions
    value: 'h'
